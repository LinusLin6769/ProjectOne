# ProjectOne system packages — restore with: brew bundle install
# Keep scoped to this project's actual needs; do not dump the whole machine.

brew "gh"           # GitHub CLI (PRs, issues, gh api)
brew "librsvg"      # rsvg-convert — SVG → raster (slides/assets)
brew "poppler"      # pdftoppm et al. — PDF → images
brew "python@3.12"  # Python for pipx-managed tools (e.g. aider)
brew "pipx"         # per-tool isolated Python app installs
